{
	"name": "kimi-companion",
	"publisher": "lekra",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.8.1",
	"license": "MIT",
	"scripts": {
		"check": "node --check extension.js && node -e \"const fs=require('fs'),cp=require('child_process');for(const f of fs.readdirSync('lib').filter(f=>f.endsWith('.js'))){const r=cp.spawnSync(process.execPath,['--check','lib/'+f],{stdio:'inherit'});if(r.status)process.exit(r.status)}\"",
		"test": "npm run check && node --test \"test/**/*.test.js\"",
		"package": "node -e \"require('child_process').execFileSync('python',['scripts/build-vsix.py','.',require('./package.json').version,'kimi-companion-'+require('./package.json').version+'.vsix'],{stdio:'inherit'})\""
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"extensionDependencies": [
		"moonshot-ai.kimi-code"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false
		},
		"virtualWorkspaces": false
	},
	"categories": [
		"AI",
		"Other"
	],
	"keywords": [
		"kimi",
		"kimi-code",
		"moonshot",
		"ai",
		"assistant"
	],
	"galleryBanner": {
		"color": "#0B0B0D",
		"theme": "dark"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"icon": "resources/icon.png",
	"contributes": {
		"icons": {
			"kimi-companion-k": {
				"description": "Kimi",
				"default": {
					"fontPath": "./resources/kimi.woff",
					"fontCharacter": "\\E001"
				}
			}
		},
		"configuration": {
			"title": "%displayName%",
			"properties": {
				"kimiCompanion.restoreTabOnStartup": {
					"type": "boolean",
					"default": true,
					"description": "%config.restore.description%"
				},
				"kimiCompanion.tabCompletionNotification": {
					"type": "boolean",
					"default": false,
					"description": "%config.tabCompletionNotification.description%"
				},
				"kimiCompanion.tabCompletionSound": {
					"type": "boolean",
					"default": true,
					"description": "%config.tabCompletionSound.description%"
				},
				"kimiCompanion.tabStatusMarkers": {
					"type": "boolean",
					"default": true,
					"description": "%config.tabStatusMarkers.description%"
				},
				"kimiCompanion.statusBarButton": {
					"type": "boolean",
					"default": true,
					"description": "%config.statusbar.description%"
				},
				"kimiCompanion.usageInStatusBar": {
					"type": "boolean",
					"default": true,
					"description": "%config.usageStatusbar.description%"
				},
				"kimiCompanion.deepseekBalance": {
					"type": "boolean",
					"default": true,
					"description": "%config.deepseekBalance.description%"
				},
				"kimiCompanion.alerts": {
					"type": "boolean",
					"default": true,
					"description": "%config.alerts.description%"
				},
				"kimiCompanion.alertThreshold5h": {
					"type": "number",
					"default": 0.8,
					"minimum": 0,
					"maximum": 1,
					"description": "%config.alert5h.description%"
				},
				"kimiCompanion.alertThresholdMonth": {
					"type": "number",
					"default": 0.9,
					"minimum": 0,
					"maximum": 1,
					"description": "%config.alertMonth.description%"
				},
				"kimiCompanion.alertDeepseekBelowUsd": {
					"type": "number",
					"default": 1,
					"minimum": 0,
					"description": "%config.deepseekBelow.description%"
				}
			}
		},
		"commands": [
			{
				"command": "kimiCompanion.open",
				"title": "%command.open.title%",
				"icon": {
					"light": "resources/kimi-icon.svg",
					"dark": "resources/kimi-icon.svg"
				}
			},
			{
				"command": "kimiCompanion.rename",
				"title": "%command.rename.title%",
				"icon": "$(pencil)"
			},
			{
				"command": "kimiCompanion.reopenClosed",
				"title": "%command.reopen.title%",
				"icon": "$(history)"
			},
			{
				"command": "kimiCompanion.usage",
				"title": "%command.usage.title%",
				"icon": "$(graph)"
			},
			{
				"command": "kimiCompanion.diagnostics",
				"title": "%command.diagnostics.title%",
				"icon": "$(pulse)"
			},
			{
				"command": "kimiCompanion.openChats",
				"title": "%command.openChats.title%",
				"icon": "$(list-selection)"
			},
			{
				"command": "kimiCompanion.nextWaitingChat",
				"title": "%command.nextWaiting.title%"
			},
			{
				"command": "kimiCompanion.nextAttentionChat",
				"title": "%command.nextAttention.title%"
			},
			{
				"command": "kimiCompanion.checkCompatibility",
				"title": "%command.checkCompatibility.title%",
				"icon": "$(checklist)"
			},
			{
				"command": "kimiCompanion.installPatch",
				"title": "%command.installPatch.title%",
				"icon": "$(tools)"
			},
			{
				"command": "kimiCompanion.restorePatch",
				"title": "%command.restorePatch.title%",
				"icon": "$(discard)"
			},
			{
				"command": "kimiCompanion.menu",
				"title": "%command.menu.title%"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "kimiCompanion.open",
					"group": "navigation"
				},
				{
					"command": "kimiCompanion.rename",
					"group": "navigation"
				},
				{
					"command": "kimiCompanion.openChats",
					"group": "navigation"
				}
			],
			"commandPalette": [
				{
					"command": "kimiCompanion.menu",
					"when": "false"
				}
			]
		},
		"keybindings": [
			{
				"command": "kimiCompanion.open",
				"key": "ctrl+alt+k",
				"mac": "cmd+alt+k"
			}
		]
	}
}
